---
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props {
  heading: string;
  paragraphsHtml: string[];
  homeLinkHtml: string;
}
const { heading, paragraphsHtml, homeLinkHtml } = Astro.props;
---
<section id="cta-final" class="pcta">
  <div class="container pcta__inner">
    <h2>{heading}</h2>
    {paragraphsHtml.map((html) => <p class="pcta__text" set:html={html} />)}
    <a class="pcta__phone" href={site.phoneHref}><Icon name="phone" size={26} /> {site.phoneDisplay}</a>
    <div class="pcta__buttons">
      <a class="btn btn--accent btn--lg" href={site.phoneHref}>Appeler maintenant</a>
      <a class="btn btn--outline btn--lg" href="/contact">Demander un devis</a>
    </div>
    <p class="pcta__home" set:html={homeLinkHtml} />
  </div>
</section>

<style>
  .pcta { background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary) 60%, #2D4A6B); color: #fff; padding: clamp(3rem, 7vw, 5rem) 0; }
  .pcta__inner { text-align: center; max-width: 760px; }
  .pcta h2 { color: #fff; }
  .pcta__text { color: rgba(255, 255, 255, 0.88); font-size: 1.05rem; }
  .pcta__text :global(a), .pcta__home :global(a) { color: #fff; font-weight: 700; }
  .pcta__phone { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-heading); font-weight: 800; font-size: clamp(1.5rem, 3.5vw, 2.2rem); color: #fff; text-decoration: none; margin: 0.5rem 0 1.25rem; }
  .pcta__buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-bottom: 1.5rem; }
  .pcta__home { margin: 0; color: rgba(255, 255, 255, 0.8); font-size: 0.95rem; }
  @media (max-width: 600px) { .pcta__buttons .btn { width: 100%; } }
</style>
