---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from './ServiceHero.astro';
import ContentSection from './ContentSection.astro';
import ChildGrid from './ChildGrid.astro';
import PageCta from './PageCta.astro';
import ChantierGallery from './ChantierGallery.astro';
import ServiceFaq from './ServiceFaq.astro';
import Sources from './Sources.astro';
import ProcessSteps from '../ProcessSteps.astro';
import { Image } from 'astro:assets';
import accueil from '../../data/accueil.json';
import { site } from '../../data/site';
import { serviceGroups } from '../../data/services';
import { pagePhotos, pageGalleries } from '../../data/photos';
import { getPhoto } from '../../lib/photos';
import { renderRich } from '../../lib/rich';
import { richContext, getPageContent, type HubContent, type ServiceContentV2 } from '../../lib/pages';
import { allServicePages } from '../../data/services';

interface Props {
  content: HubContent | (ServiceContentV2 & { homeLink: string; gridIntro?: string; gridHeading?: string; childDescriptions?: Record<string, string> });
}


const { content: c } = Astro.props;
const v2 = 'tech' in c ? (c as ServiceContentV2 & { homeLink: string; gridIntro?: string; gridHeading?: string; childDescriptions?: Record<string, string> }) : null;
const v1 = 'services' in c ? (c as HubContent) : null;
const group = serviceGroups.find((g) => g.slug === c.slug);
if (!group) throw new Error(`HubPage : groupe inconnu ${c.slug}`);
const ctx = richContext();
const rich = (t: string) => renderRich(t, ctx);
const plain = (t: string) => t.replace(/\[\[home:([^\]]+)\]\]/g, '$1').replace(/\[\[([^\]]+)\]\]/g, '$1');
const photo = getPhoto(pagePhotos[c.slug]);
const gallery = (pageGalleries[c.slug] ?? []).map((id) => { const ph = getPhoto(id); return { image: ph.image, alt: ph.alt, caption: ph.caption ?? ph.alt }; });
const hero = await getImage({ src: photo.image, width: 1600, height: 900, widths: [768, 1200, 1600], sizes: '100vw', format: 'webp', quality: 72 });
const preloads = [{ href: hero.src, imagesrcset: hero.srcSet.attribute, imagesizes: '100vw' }];
const children = group.children.map((ch) => { const cc = getPageContent(ch.slug); return { ...ch, description: c.childDescriptions?.[ch.slug] ?? (cc && 'summary' in cc ? cc.summary : '') }; });
const orgId = `${site.domain}/#organisation`;
const pageUrl = `${site.domain}/${c.slug}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      // Nœud organisation minimal pour que provider/@id soit résoluble sur cette page (NAP complet sur l'accueil)
      '@type': 'RoofingContractor',
      '@id': orgId,
      name: site.name,
      url: `${site.domain}${site.homeHref}`,
      telephone: site.phoneHref.replace('tel:', ''),
      address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.city, postalCode: site.address.postalCode, addressRegion: site.address.region, addressCountry: site.address.country },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: c.name,
      serviceType: c.name,
      url: pageUrl,
      description: c.metaDescription,
      provider: { '@id': orgId },
      areaServed: [{ '@type': 'City', name: site.city }, { '@type': 'AdministrativeArea', name: site.address.region }],
      hasOfferCatalog: { '@type': 'OfferCatalog', name: `${c.name} à Bruxelles`, itemListElement: children.map((ch) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: ch.name, url: `${site.domain}/${ch.slug}` } })) },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.domain}${site.homeHref}` },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.domain}/services` },
        { '@type': 'ListItem', position: 3, name: c.name, item: pageUrl },
      ],
    },
    // FAQ : mêmes questions et réponses que la section visible (texte sans balises de lien)
    { '@type': 'FAQPage', '@id': `${pageUrl}#faq`, mainEntity: c.faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: plain(q.answer) } })) },
    { '@type': 'WebPage', '@id': pageUrl, url: pageUrl, name: c.metaTitle, inLanguage: 'fr-BE', datePublished: '2026-10-12', dateModified: c.updated, isPartOf: { '@type': 'WebSite', url: site.domain, name: site.name }, about: { '@id': orgId } },
  ],
};
const faqHeading = c.faqHeading ?? `${c.name} : vos questions`;
const slugByName = new Map(allServicePages().map((pg) => [pg.name, pg.slug]));
const problemItems = (v2?.problems.items ?? []).map((it) => {
  const first = it.solution.match(/\[\[(?!home:)([^\]]+)\]\]/)?.[1];
  const s2 = first ? slugByName.get(first) : undefined;
  const ph = s2 && pagePhotos[s2] ? getPhoto(pagePhotos[s2]) : null;
  return { ...it, image: ph?.image, alt: ph?.alt, href: s2 ? `/${s2}` : undefined };
});
const faqItems = c.faq.map((q) => ({ question: q.question, answerHtml: rich(q.answer) }));
---
<BaseLayout title={c.metaTitle} description={c.metaDescription} preloads={preloads} ogImage={hero.src}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </Fragment>
  <ServiceHero h1={c.h1} subheadlineHtml={rich(c.heroSubheadline)} image={hero} imageAlt={photo.alt} trustStrip={accueil.trustStrip} breadcrumb={[{ label: 'Accueil', href: site.homeHref }, { label: 'Services', href: '/services' }, { label: c.name }]} />
  <article id="contenu" class="section">
    <div class="container prose">
      <ContentSection paragraphsHtml={c.opening.map(rich)} />
      {v1 && <ContentSection h2={v1.problems.h2} paragraphsHtml={v1.problems.paragraphs.map(rich)} />}
      {v1 && <ContentSection h2={v1.services.h2} paragraphsHtml={v1.services.paragraphs.map(rich)} />}
      {v1 && <ContentSection h2={v1.local.h2} paragraphsHtml={v1.local.paragraphs.map(rich)} />}
      {v1 && v1.expect && <ContentSection h2={v1.expect.h2} paragraphsHtml={v1.expect.paragraphs.map(rich)} />}
      {v1 && <ContentSection h2={v1.why.h2} paragraphsHtml={v1.why.paragraphs.map(rich)} />}
      {v2 && (
        <section class="prose-block zone-problems" id="problemes">
          <h2>{v2.problems.h2}</h2>
          <ul class="zone-problems__list">
            {problemItems.map((it) => (
              <li class="zone-problems__item">
                {it.image && <a class="zone-problems__photo" href={it.href} tabindex="-1"><Image src={it.image} alt={it.alt!} width={480} height={270} format="webp" quality={72} loading="lazy" /></a>}
                <div class="zone-problems__text">
                  <h3 class="zone-problems__q" set:html={rich(it.problem)} />
                  <p class="zone-problems__a" set:html={rich(it.solution)} />
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
      {v2 && (
        <section class="prose-block tech" id="technique">
          <h2>{v2.tech.h2}</h2>
          <ul class="tech__list">{v2.tech.items.map((it) => <li><strong>{it.label}</strong> <span set:html={rich(it.text)} /></li>)}</ul>
        </section>
      )}
      {v2 && <ProcessSteps />}
      {v2 && (
        <section class="prose-block cost" id="prix">
          <h2>{v2.cost.h2}</h2>
          <ul class="tech__list tech__list--cost">{v2.cost.items.map((it) => <li set:html={rich(it)} />)}</ul>
        </section>
      )}
    </div>
  </article>
  <Sources items={c.sources} updated={c.updated} />
  {gallery.length > 0 && <ChantierGallery items={gallery} />}
  <ServiceFaq heading={faqHeading} items={faqItems} />
  <ChildGrid heading={c.gridHeading ?? 'Nos interventions en détail'} intro={c.gridIntro} items={children} />
  <PageCta heading={v2 ? `Un problème de ${c.name.charAt(0).toLowerCase()}${c.name.slice(1)} ?` : 'Parlons de votre toiture'} paragraphsHtml={c.finalCta.paragraphs.map(rich)} homeLinkHtml={rich(c.homeLink)} />
</BaseLayout>

<style>
  .zone-problems__list { list-style: none; padding: 0; display: grid; gap: 0.9rem; margin: 0 0 1.5rem; }
  .zone-problems__item { display: grid; grid-template-columns: minmax(0, 220px) 1fr; gap: 1rem 1.25rem; align-items: start; border: 1px solid var(--color-line); border-left: 4px solid var(--color-accent); border-radius: var(--radius); background: #fff; padding: 1rem 1.25rem; }
  .zone-problems__item:not(:has(.zone-problems__photo)) { grid-template-columns: 1fr; }
  .zone-problems__photo { display: block; border-radius: calc(var(--radius) - 4px); overflow: hidden; }
  .zone-problems__photo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .zone-problems__text { min-width: 0; }
  .zone-problems__q { font-family: var(--font-heading); font-weight: 700; font-size: 1.05rem; color: var(--color-primary); margin: 0 0 0.35rem; }
  .zone-problems__a { margin: 0; color: var(--color-muted); }
  @media (max-width: 640px) { .zone-problems__item { grid-template-columns: 1fr; } }
  .tech__list { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: 0.6rem; }
  .tech__list li { padding-left: 1.6rem; position: relative; }
  .tech__list li::before { content: "✓"; position: absolute; left: 0; color: var(--color-accent-dark); font-weight: 700; }
  .tech__list strong { font-family: var(--font-heading); color: var(--color-primary); }
  .tech__list--cost li::before { content: "→"; }
</style>
