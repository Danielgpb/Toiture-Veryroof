---
import { pending } from '../../data/site';
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props {
  headline: string;
  subtext: string;
  hours: string;
}

const { headline, subtext, hours } = Astro.props;
const hoursLine = pending.officeHours ? `Bureau : ${pending.officeHours} · ${hours}` : hours;
---
<section id="cta-final" class="final">
  <div class="container final__inner">
    <p class="eyebrow eyebrow--light">Parlons de votre toit</p>
    <h2>{headline}</h2>
    <p class="final__sub">{subtext}</p>
    <a class="final__phone" href={site.phoneHref}><Icon name="phone" size={28} /> {site.phoneDisplay}</a>
    <div class="final__cta">
      <a class="btn btn--accent btn--lg" href={site.phoneHref}>Appeler maintenant</a>
      <a class="btn btn--outline btn--lg" href="#devis">Demander un devis</a>
    </div>
    <p class="final__hours"><Icon name="clock" size={18} /> {hoursLine}</p>
  </div>
</section>

<style>
  .final { background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary) 60%, #2D4A6B); color: #fff; padding: clamp(3rem, 8vw, 5.5rem) 0; }
  .final__inner { text-align: center; max-width: 760px; }
  .eyebrow--light { color: #F3B48F; }
  .final h2 { color: #fff; font-size: clamp(1.7rem, 3.5vw, 2.5rem); }
  .final__sub { color: rgba(255, 255, 255, 0.85); font-size: 1.1rem; }
  .final__phone { display: inline-flex; align-items: center; gap: 0.6rem; font-family: var(--font-heading); font-weight: 800; font-size: clamp(1.6rem, 4vw, 2.4rem); color: #fff; text-decoration: none; margin: 0.5rem 0 1.5rem; }
  .final__cta { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-bottom: 1.5rem; }
  .final__hours { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0; color: rgba(255, 255, 255, 0.8); font-size: 0.95rem; }
  @media (max-width: 600px) { .final__cta .btn { width: 100%; } }
</style>
