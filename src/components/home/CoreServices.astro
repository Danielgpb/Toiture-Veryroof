---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';

interface Props {
  heading: string;
  items: { name: string; slug: string; description: string; photo: { image: ImageMetadata; alt: string } }[];
}

const { heading, items } = Astro.props;
---
<section id="services-phares" class="section core">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Services phares</p>
      <h2 class="section-title">{heading}</h2>
    </div>
    <div class="core__list">
      {items.map((it) => (
        <article class="core__item">
          <div class="core__visual"><Image class="core__img" src={it.photo.image} alt={it.photo.alt} width={720} height={560} format="webp" quality={78} /></div>
          <div class="core__body">
            <h3><a href={it.slug}>{it.name}</a></h3>
            <p>{it.description}</p>
            <a class="btn btn--primary" href={it.slug}>En savoir plus <Icon name="arrow" size={18} /></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .core__list { display: grid; gap: 1.5rem; }
  .core__item { display: grid; grid-template-columns: 1fr; border: 1px solid var(--color-line); border-radius: var(--radius); overflow: hidden; background: #fff; box-shadow: var(--shadow); }
  @media (min-width: 800px) { .core__item { grid-template-columns: 360px 1fr; } .core__item:nth-child(even) { grid-template-columns: 1fr 360px; } .core__item:nth-child(even) .core__visual { order: 2; } }
  .core__visual { min-height: 220px; background: var(--color-primary-soft); }
  .core__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .core__body { padding: 2rem; }
  .core__body h3 { font-size: 1.5rem; margin-bottom: 0.75rem; }
  .core__body h3 a { text-decoration: none; color: var(--color-primary); }
  .core__body h3 a:hover { color: var(--color-accent); }
  .core__body p { color: var(--color-muted); margin-bottom: 1.25rem; }
</style>
