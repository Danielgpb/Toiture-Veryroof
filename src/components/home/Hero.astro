---
import type { GetImageResult } from 'astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { linkPhone } from '../../lib/phone';

interface Props {
  h1: string;
  subheadline: string;
  trustStrip: string[];
  eyebrow: string;
  /** Variante bureau (paysage) et mobile (portrait) de la photo de fond, produites par getImage dans la page. */
  desktop: GetImageResult;
  mobile: GetImageResult;
  alt: string;
}

const { h1, subheadline, trustStrip, eyebrow, desktop, mobile, alt } = Astro.props;
---
<section id="hero" class="hero">
  <picture class="hero__bg">
    <source media="(max-width: 700px)" srcset={mobile.srcSet.attribute} sizes="100vw" />
    <img src={desktop.src} srcset={desktop.srcSet.attribute} sizes="100vw" width={desktop.attributes.width} height={desktop.attributes.height} fetchpriority="high" decoding="async" alt={alt} />
  </picture>
  <div class="container hero__inner">
   <div class="hero__content">
    <p class="hero__eyebrow">{eyebrow}</p>
    <h1>{h1}</h1>
    <p class="hero__sub" set:html={linkPhone(subheadline, site.phoneDisplay, site.phoneHref)} />
    <div class="hero__cta">
      <a class="btn btn--accent btn--lg" href={site.phoneHref}><Icon name="phone" size={20} /> Appeler le {site.phoneDisplay}</a>
      <a class="btn btn--outline btn--lg" href="#devis">Devis gratuit</a>
    </div>
    <ul class="trust">
      {trustStrip.map((t) => <li><Icon name="check" size={18} /> {t}</li>)}
    </ul>
   </div>
  </div>
</section>

<style>
  .hero { position: relative; color: #fff; overflow: hidden; isolation: isolate; }
  .hero__bg { position: absolute; inset: 0; z-index: -2; margin: 0; }
  .hero__bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(100deg, rgba(12, 22, 38, 0.86) 0%, rgba(12, 22, 38, 0.55) 48%, rgba(12, 22, 38, 0.12) 100%), linear-gradient(0deg, rgba(12, 22, 38, 0.5) 0%, rgba(12, 22, 38, 0) 40%); }
  .hero__inner { padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2.5rem, 6vw, 4.5rem); }
  .hero__content { max-width: 760px; }
  .hero__eyebrow { font-family: var(--font-heading); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase; color: #F3B48F; margin: 0 0 1rem; }
  .hero h1 { color: #fff; font-size: clamp(2rem, 4.6vw, 3.3rem); margin-bottom: 1rem; text-wrap: balance; text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35); }
  .hero__sub { font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: rgba(255, 255, 255, 0.92); max-width: 60ch; margin-bottom: 1.75rem; text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35); }
  .hero__sub :global(a) { color: #fff; font-weight: 700; text-decoration-color: var(--color-accent); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem; }
  .trust { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; font-weight: 600; font-size: 0.95rem; text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4); }
  .trust li { display: inline-flex; align-items: center; gap: 0.45rem; }
  .trust svg { color: #F3B48F; }
  @media (max-width: 600px) { .hero__cta .btn { width: 100%; } }
</style>
