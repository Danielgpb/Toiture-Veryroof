---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCall from '../components/FloatingCall.astro';
import StickyCtaBar from '../components/StickyCtaBar.astro';
import { site } from '../data/site';
import { cleanPath } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
  /** 'floating' = bouton rond « Appeler » (défaut) ; 'bar' = barre collante à deux boutons (accueil). */
  mobileCta?: 'floating' | 'bar';
  /** Images à précharger (photo du hero, au-dessus de la ligne de flottaison), une entrée par variante responsive. */
  preloads?: { href: string; imagesrcset?: string; imagesizes?: string; media?: string }[];
  /** Image de partage (Open Graph) : chemin absolu du site ou URL complète ; par défaut l'image générique du site. */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description = `${site.name} — ${site.tagline}.`, mobileCta = 'floating', preloads = [], ogImage = '/images/og-default.jpg', ogType = 'website' } = Astro.props;
const canonical = new URL(cleanPath(Astro.url.pathname), site.domain).href;
const ogImageUrl = /^https?:/.test(ogImage) ? ogImage : new URL(ogImage, site.domain).href;
const fontsHref = 'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1B2A41" />
    {preloads.map((p) => <link rel="preload" as="image" href={p.href} imagesrcset={p.imagesrcset} imagesizes={p.imagesizes} media={p.media} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {mobileCta === 'bar' ? <StickyCtaBar /> : <FloatingCall />}
  </body>
</html>
