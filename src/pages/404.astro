---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { serviceGroups } from '../data/services';
---
<BaseLayout title={`Page introuvable | ${site.name}`} description="La page demandée n'existe pas ou a été déplacée. Retrouvez nos services de toiture à Bruxelles ou appelez-nous.">
  <section class="page-head">
    <div class="container">
      <p class="eyebrow">Oups</p>
      <h1>Page introuvable</h1>
      <p>La page que vous cherchez a peut-être été déplacée ou n'existe plus. Pas de panique : tout est à portée de clic ci-dessous.</p>
    </div>
  </section>
  <section class="section">
    <div class="container notfound">
      <p class="notfound__actions"><a class="btn btn--primary" href={`/${site.homeSlug}`}>Retour à l'accueil</a> <a class="btn btn--accent" href="/services">Voir tous nos services</a></p>
      <p>Ou appelez-nous directement au <a href={site.phoneHref}>{site.phoneDisplay}</a>, dépannage 24h/24, 7j/7.</p>
      <h2>Nos grandes familles de services</h2>
      <ul class="notfound__list">
        {serviceGroups.map((g) => <li><a href={`/${g.slug}`}>{g.name}</a></li>)}
        <li><a href="/contact">Demander un devis gratuit</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .notfound h2 { margin-top: 2rem; font-size: 1.25rem; }
  .notfound__list { display: grid; gap: 0.5rem; padding-left: 1.2rem; }
</style>
